# ============================================================
# TRACE - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)
# ============================================================

# ============================================================
# GOOGLE API (Required for Local/Gemini Mode)
# ============================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# This is REQUIRED to use AI features locally
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# AWS CREDENTIALS (Required for AWS/Bedrock Mode)
# ============================================================
# Get from AWS Console > IAM > Security Credentials
# Only needed if deploying to AWS or using Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ============================================================
# AI BACKEND SELECTION
# ============================================================
# Options: auto, gemini, bedrock
# - auto: Uses Gemini if GOOGLE_API_KEY is set, otherwise Bedrock
# - gemini: Forces Google Gemini (requires GOOGLE_API_KEY)
# - bedrock: Forces AWS Bedrock (requires AWS credentials)
TRACE_AI_BACKEND=auto

# ============================================================
# MODEL CONFIGURATION
# ============================================================
# Gemini Models: gemini-2.0-flash (fast), gemini-1.5-pro (reasoning)
# Bedrock Models: claude-3-sonnet (fast), claude-3-opus (reasoning)
DEFAULT_MODEL=gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-1.5-pro
TEMPERATURE=0.7

# ============================================================
# SYSTEM CONFIGURATION
# ============================================================
LOG_LEVEL=INFO
ENABLE_TELEMETRY=true

# ============================================================
# AGENT CONFIGURATION
# ============================================================
MAX_RETRY_ATTEMPTS=3
HEALTH_CHECK_INTERVAL=60
AUTO_REMEDIATION_ENABLED=true

# ============================================================
# NETWORK THRESHOLDS (Optional - Tune for your environment)
# ============================================================
ENERGY_SAVING_THRESHOLD=0.3
CONGESTION_THRESHOLD=0.8
CPU_USAGE_THRESHOLD=80
MEMORY_USAGE_THRESHOLD=85

# ============================================================
# RATE LIMITING (Optional)
# ============================================================
GEMINI_RATE_LIMIT=60
GEMINI_CACHE_TTL=300
GEMINI_STREAMING_ENABLED=true
